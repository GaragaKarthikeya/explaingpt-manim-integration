# ExplainGPT-Manim Integration Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Google Gemini API Key (REQUIRED)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# =============================================================================
# BASIC APPLICATION SETTINGS
# =============================================================================

# Application name for logging and API documentation
APP_NAME="Manim Animation Server"

# Port for the web server (default: 8000)
PORT=8000

# Directory where generated videos are stored
MANIM_OUTPUT_DIR="./output_videos"

# =============================================================================
# PERFORMANCE AND WORKER CONFIGURATION
# =============================================================================

# Maximum number of concurrent animation renderings
# Recommended: CPU cores minus 1 (leave 1 core for system)
MAX_PARALLEL_RENDERINGS=2

# Minimum memory required per worker in MB
# Recommended: 2048MB (2GB) for quality animations
MIN_MEMORY_PER_WORKER_MB=2048

# Maximum system memory to use (percentage, 0-100)
# Recommended: 80% to leave memory for system operations
MAX_MEMORY_PERCENT=80

# Enable automatic worker scaling based on system load
ENABLE_DYNAMIC_SCALING=true

# CPU load thresholds for scaling (0.0-1.0)
HIGH_LOAD_THRESHOLD=0.8  # Scale down when CPU > 80%
LOW_LOAD_THRESHOLD=0.3   # Scale up when CPU < 30%

# Resource monitoring interval in seconds
MONITORING_INTERVAL_SEC=30

# =============================================================================
# QUEUE AND RATE LIMITING
# =============================================================================

# Maximum number of jobs that can be queued
MAX_QUEUE_SIZE=10

# How long to keep generated videos (hours)
CACHE_EXPIRY_HOURS=24

# Maximum API requests per minute per IP address
RATE_LIMIT_PER_MINUTE=5

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Gemini model to use (see list_gemini_models.py for available models)
GEMINI_MODEL="models/gemini-2.0-flash"

# =============================================================================
# NETWORK AND NGROK CONFIGURATION
# =============================================================================

# Enable ngrok tunneling for external access (true/false)
ENABLE_NGROK=true

# Ngrok authentication token (get from https://ngrok.com)
# Leave empty to disable ngrok
NGROK_AUTHTOKEN=""

# Optional: Static ngrok domain (for paid accounts)
NGROK_DOMAIN=""

# Ngrok connection retry settings
NGROK_MAX_RETRIES=2
NGROK_RETRY_DELAY=2

# Current ngrok base URL (automatically set, don't modify manually)
NGROK_BASE_URL=""

# =============================================================================
# ERROR RECOVERY SYSTEM
# =============================================================================

# Enable automatic error recovery and code repair
ERROR_RECOVERY_ENABLED=true

# Maximum number of retry attempts for failed jobs
ERROR_RECOVERY_MAX_RETRIES=3

# Timeout for code execution in sandboxed environment (seconds)
ERROR_RECOVERY_SANDBOX_TIMEOUT=30

# =============================================================================
# RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# =============================================================================

# Enable RAG for improved code generation
RAG_ENABLED=true

# File paths for RAG database (auto-created if not exist)
RAG_INDEX_PATH="./data/manim_index.faiss"
RAG_BLOCKS_PATH="./data/manim_blocks.npy"

# Minimum similarity score for example retrieval (0.0-1.0)
RAG_MIN_SCORE=0.5

# Maximum number of examples to retrieve for context
RAG_MAX_EXAMPLES=3

# =============================================================================
# ENVIRONMENT-SPECIFIC CONFIGURATIONS
# =============================================================================

# Development Configuration Example:
# MAX_PARALLEL_RENDERINGS=1
# MIN_MEMORY_PER_WORKER_MB=1024
# ENABLE_DYNAMIC_SCALING=false
# RATE_LIMIT_PER_MINUTE=20

# Production Configuration Example:
# MAX_PARALLEL_RENDERINGS=4
# MIN_MEMORY_PER_WORKER_MB=4096
# MAX_MEMORY_PERCENT=85
# ENABLE_NGROK=false
# RATE_LIMIT_PER_MINUTE=5

# Low-Resource Configuration Example:
# MAX_PARALLEL_RENDERINGS=1
# MIN_MEMORY_PER_WORKER_MB=1024
# MAX_MEMORY_PERCENT=60
# MAX_QUEUE_SIZE=3
# ENABLE_DYNAMIC_SCALING=false

# =============================================================================
# NOTES
# =============================================================================

# 1. The GEMINI_API_KEY is required for the service to function
# 2. Adjust worker settings based on your system capabilities
# 3. Enable ngrok for external access during development
# 4. Monitor system resources via /system/resources endpoint
# 5. See docs/configuration-reference.md for detailed explanations